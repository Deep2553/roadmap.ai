# Copy to .env.local, then fill in AUTH_SECRET:
#   cp .env.example .env.local
#   printf 'AUTH_SECRET=%s\n' "$(openssl rand -base64 32)" >> .env.local
# Required — Auth.js refuses every request with "MissingSecret" without it.
AUTH_SECRET=

# Production only. Unset locally, the app uses ./sqlite.db via better-sqlite3.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional seed overrides (npm run db:seed).
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
